        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    %% ==========================================\n    %% FULL SYSTEM DESIGN\n    %% ==========================================\n\n    subgraph FULL[\&quot;ASMATrack - FULL SYSTEM DESIGN\&quot;]\n        direction TB\n\n        subgraph INPUT[\&quot;1. Respiratory Data Acquisition\&quot;]\n            direction TB\n            A1[\&quot;Microphone / Acoustic Sensor\&quot;]\n            A2[\&quot;Analog Front-End\&quot;]\n            A3[\&quot;Anti-Aliasing Filter\&quot;]\n            A4[\&quot;ADC\&quot;]\n            A5[\&quot;Digital Audio Samples\&quot;]\n            A1 --&gt; A2 --&gt; A3 --&gt; A4 --&gt; A5\n        end\n\n        subgraph DSP[\&quot;2. FPGA / Chip DSP Processing\&quot;]\n            direction TB\n            B1[\&quot;Input Buffering\&quot;]\n            B2[\&quot;Signal Quality Assessment\&quot;]\n            B3[\&quot;Digital Band-Pass FIR Filter\&quot;]\n            B4[\&quot;Goertzel Frequency Analysis\&quot;]\n            B5[\&quot;Spectral Energy Features\&quot;]\n            B6[\&quot;Feature Normalization\&quot;]\n            B7[\&quot;DSP Feature Vector\&quot;]\n            B1 --&gt; B2 --&gt; B3 --&gt; B4 --&gt; B5 --&gt; B6 --&gt; B7\n        end\n\n        subgraph AI[\&quot;3. Edge AI Processing\&quot;]\n            direction TB\n            C1[\&quot;Lightweight ML Inference\&quot;]\n            C2[\&quot;Wheezing Candidate Classification\&quot;]\n            C3[\&quot;Longitudinal Feature Tracking\&quot;]\n            C4[\&quot;Personalized Anomaly Detection\&quot;]\n            C5[\&quot;Future Exacerbation-Risk Estimation\&quot;]\n            B7 --&gt; C1 --&gt; C2\n            C2 --&gt; C3 --&gt; C4 --&gt; C5\n        end\n\n        subgraph PHYS[\&quot;4. Supporting Physiological Sensors\&quot;]\n            direction TB\n            D1[\&quot;Heart Rate Sensor\&quot;]\n            D2[\&quot;SpO2 Sensor\&quot;]\n            D3[\&quot;Signal Quality Validation\&quot;]\n            D4[\&quot;Physiological Feature Vector\&quot;]\n            D1 --&gt; D3\n            D2 --&gt; D3\n            D3 --&gt; D4\n        end\n\n        subgraph FUSION[\&quot;5. Multimodal Integration\&quot;]\n            direction TB\n            E1[\&quot;Respiratory Acoustic Features\&quot;]\n            E2[\&quot;Physiological Features\&quot;]\n            E3[\&quot;Feature Fusion\&quot;]\n            E4[\&quot;Risk Assessment\&quot;]\n            E1 --&gt; E3\n            E2 --&gt; E3\n            E3 --&gt; E4\n        end\n\n        subgraph OUTPUT[\&quot;6. User Output and Connectivity\&quot;]\n            direction TB\n            F1[\&quot;Alert Decision Logic\&quot;]\n            F2[\&quot;Local Feedback\&quot;]\n            F3[\&quot;BLE / Wi-Fi Communication\&quot;]\n            F4[\&quot;Mobile Application\&quot;]\n            F5[\&quot;Monitoring History\&quot;]\n            F1 --&gt; F2\n            F1 --&gt; F3 --&gt; F4 --&gt; F5\n        end\n\n        A5 --&gt; B1\n        B7 --&gt; E1\n        C2 --&gt; F1\n        C5 --&gt; F1\n        D4 --&gt; E2\n        E4 --&gt; F1\n    end\n\n    %% ==========================================\n    %% POC SCOPE - SUBSET OF FULL DESIGN\n    %% ==========================================\n\n    subgraph POC[\&quot;ASMATrack - HACKATHON POC SCOPE\&quot;]\n        direction TB\n\n        subgraph DATA[\&quot;A. Public Dataset and Python Reference\&quot;]\n            direction TB\n            P1[\&quot;ICBHI 2017 Dataset\&quot;]\n            P2[\&quot;HF_Lung_V1 Dataset\&quot;]\n            P3[\&quot;Audio Preprocessing in Python\&quot;]\n            P4[\&quot;Reference FIR and Goertzel\&quot;]\n            P5[\&quot;Segment Labels and Expected Features\&quot;]\n            P1 --&gt; P3\n            P2 --&gt; P3\n            P3 --&gt; P4 --&gt; P5\n        end\n\n        subgraph RTL[\&quot;B. RTL DSP Implementation\&quot;]\n            direction TB\n            R1[\&quot;Audio Sample Replay\&quot;]\n            R2[\&quot;Fixed-Point FIR Band-Pass\&quot;]\n            R3[\&quot;Goertzel Feature Extraction\&quot;]\n            R4[\&quot;Numerical DSP Feature Output\&quot;]\n            R1 --&gt; R2 --&gt; R3 --&gt; R4\n        end\n\n        subgraph VERIFY[\&quot;C. Verification and Evaluation\&quot;]\n            direction TB\n            V1[\&quot;RTL Simulation and Testbench\&quot;]\n            V2[\&quot;Export RTL Results to TXT\&quot;]\n            V3[\&quot;Python Numerical Comparison\&quot;]\n            V4[\&quot;Error and Feature Consistency Metrics\&quot;]\n            V5[\&quot;Optional FPGA Implementation\&quot;]\n            V1 --&gt; V2 --&gt; V3 --&gt; V4\n            V4 -.-&gt; V5\n        end\n\n        subgraph BASELINE[\&quot;D. Python ML Baseline\&quot;]\n            direction TB\n            M1[\&quot;Build Labeled Audio Segments\&quot;]\n            M2[\&quot;Extract Reference Features\&quot;]\n            M3[\&quot;Logistic Regression\&quot;]\n            M4[\&quot;Linear SVM Comparison\&quot;]\n            M5[\&quot;Sensitivity, Specificity and F1-Score\&quot;]\n            M1 --&gt; M2 --&gt; M3\n            M2 --&gt; M4\n            M3 --&gt; M5\n            M4 --&gt; M5\n        end\n\n        P5 --&gt; R1\n        P5 --&gt; M1\n        R4 --&gt; V1\n        R4 -.-&gt; M2\n    end\n\n    %% ==========================================\n    %% VISUAL STYLES - WHITE FILL, OUTLINE ONLY\n    %% ==========================================\n\n    classDef component fill:#ffffff,stroke:#2563eb,stroke-width:1.5px,color:#111111;\n    classDef poccomponent fill:#ffffff,stroke:#16a34a,stroke-width:2px,color:#111111;\n    classDef future fill:#ffffff,stroke:#d97706,stroke-width:1.5px,color:#111111,stroke-dasharray:5 5;\n\n    class A1,A2,A3,A4,A5,B1,B2,B3,B4,B5,B6,B7,C1,C2,D1,D2,D3,D4,E1,E2,E3,F1,F2,F3,F4,F5 component;\n    class C3,C4,C5,E4 future;\n    class P1,P2,P3,P4,P5,R1,R2,R3,R4,V1,V2,V3,V4,V5,M1,M2,M3,M4,M5 poccomponent;\n\n    style FULL fill:#ffffff,stroke:#2563eb,stroke-width:2px,color:#111111\n    style INPUT fill:#ffffff,stroke:#2563eb,color:#111111\n    style DSP fill:#ffffff,stroke:#2563eb,color:#111111\n    style AI fill:#ffffff,stroke:#2563eb,color:#111111\n    style PHYS fill:#ffffff,stroke:#2563eb,color:#111111\n    style FUSION fill:#ffffff,stroke:#2563eb,color:#111111\n    style OUTPUT fill:#ffffff,stroke:#2563eb,color:#111111\n\n    style POC fill:#ffffff,stroke:#16a34a,stroke-width:3px,color:#111111\n    style DATA fill:#ffffff,stroke:#16a34a,color:#111111\n    style RTL fill:#ffffff,stroke:#16a34a,color:#111111\n    style VERIFY fill:#ffffff,stroke:#16a34a,color:#111111\n    style BASELINE fill:#ffffff,stroke:#16a34a,color:#111111\n&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mKZ5JzS8KgBF5nCEPrLf-350">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />

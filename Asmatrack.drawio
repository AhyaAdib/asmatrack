        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nflowchart TB\n\n    %% ==========================================\n    %% FULL SYSTEM ASMATrack\n    %% ==========================================\n\n    subgraph ASMA[\&quot;ASMATrack - FULL SYSTEM DESIGN\&quot;]\n        direction TB\n\n        A[\&quot;1. Akuisisi Suara Pernapasan\&quot;]\n        B[\&quot;2. Analog Front-End dan ADC\&quot;]\n        C[\&quot;3. Buffering dan Pemeriksaan Kualitas Sinyal\&quot;]\n\n        subgraph POC[\&quot;HACKATHON PoC SCOPE\&quot;]\n            direction TB\n\n            subgraph DATA[\&quot;A. Dataset dan Referensi Python\&quot;]\n                direction TB\n                P1[\&quot;Dataset ICBHI 2017\&quot;]\n                P2[\&quot;Dataset HF_Lung_V1\&quot;]\n                P3[\&quot;Preprocessing Audio dan Pelabelan Segmen\&quot;]\n                P4[\&quot;Referensi DSP Python\&quot;]\n                P1 --&gt; P3\n                P2 --&gt; P3\n                P3 --&gt; P4\n            end\n\n            subgraph RTL[\&quot;B. Implementasi DSP pada RTL\&quot;]\n                direction TB\n                R1[\&quot;Replay Sampel Audio\&quot;]\n                R2[\&quot;FIR Band-Pass Fixed-Point\&quot;]\n                R3[\&quot;Ekstraksi Fitur Goertzel\&quot;]\n                R4[\&quot;Keluaran Fitur DSP Numerik\&quot;]\n                R1 --&gt; R2 --&gt; R3 --&gt; R4\n            end\n\n            subgraph VER[\&quot;C. Verifikasi RTL\&quot;]\n                direction TB\n                V1[\&quot;Testbench dan Simulasi RTL\&quot;]\n                V2[\&quot;Ekspor Hasil Simulasi ke TXT\&quot;]\n                V3[\&quot;Evaluasi dengan Python\&quot;]\n                V4[\&quot;Perbandingan Error Numerik\&quot;]\n                V5[\&quot;Evaluasi Konsistensi Fitur\&quot;]\n                V1 --&gt; V2 --&gt; V3 --&gt; V4 --&gt; V5\n            end\n\n            subgraph ML[\&quot;D. Baseline Machine Learning\&quot;]\n                direction TB\n                M1[\&quot;Penyusunan Fitur dan Label\&quot;]\n                M2[\&quot;Logistic Regression\&quot;]\n                M3[\&quot;Linear SVM sebagai Pembanding\&quot;]\n                M4[\&quot;Evaluasi Sensitivitas, Spesifisitas, dan F1\&quot;]\n                M1 --&gt; M2 --&gt; M4\n                M1 --&gt; M3 --&gt; M4\n            end\n\n            P4 --&gt; R1\n            P4 --&gt; M1\n            R4 --&gt; V1\n        end\n\n        D[\&quot;4. Inferensi Edge AI pada Perangkat\&quot;]\n        E[\&quot;5. Deteksi Kandidat Wheezing\&quot;]\n        F[\&quot;6. Pelacakan Fitur Respirasi dari Waktu ke Waktu\&quot;]\n\n        subgraph FUTURE[\&quot;PENGEMBANGAN JANGKA PANJANG\&quot;]\n            direction TB\n\n            G[\&quot;7. Sensor Pendukung HR dan SpO2\&quot;]\n            H[\&quot;8. Validasi Kualitas dan Fusi Multimodal\&quot;]\n            I[\&quot;9. Anomaly Detection Personal\&quot;]\n            J[\&quot;10. Estimasi Risiko Eksaserbasi\&quot;]\n            K[\&quot;11. Logika Peringatan Lokal\&quot;]\n            L[\&quot;12. BLE atau Wi-Fi\&quot;]\n            N[\&quot;13. Aplikasi dan Riwayat Pemantauan\&quot;]\n\n            G --&gt; H\n            H --&gt; I --&gt; J --&gt; K\n            K --&gt; L --&gt; N\n        end\n\n        A --&gt; B --&gt; C\n        C --&gt; D\n        D --&gt; E\n        E --&gt; F\n        F --&gt; I\n        F --&gt; K\n        E --&gt; K\n    end\n\n    %% ==========================================\n    %% STYLE - WHITE FILL, OUTLINE ONLY\n    %% ==========================================\n\n    classDef system fill:#ffffff,stroke:#333333,stroke-width:2px,color:#111111;\n    classDef pocNode fill:#ffffff,stroke:#16803c,stroke-width:1.5px,color:#111111;\n    classDef futureNode fill:#ffffff,stroke:#b7791f,stroke-width:1.5px,stroke-dasharray:5 5,color:#111111;\n\n    class A,B,C,D,E,F system;\n    class P1,P2,P3,P4,R1,R2,R3,R4,V1,V2,V3,V4,V5,M1,M2,M3,M4 pocNode;\n    class G,H,I,J,K,L,N futureNode;\n\n    style ASMA fill:#ffffff,stroke:#333333,stroke-width:3px,color:#111111\n    style POC fill:#ffffff,stroke:#16803c,stroke-width:3px,color:#111111\n    style DATA fill:#ffffff,stroke:#16803c,stroke-width:1.5px,color:#111111\n    style RTL fill:#ffffff,stroke:#16803c,stroke-width:1.5px,color:#111111\n    style VER fill:#ffffff,stroke:#16803c,stroke-width:1.5px,color:#111111\n    style ML fill:#ffffff,stroke:#16803c,stroke-width:1.5px,color:#111111\n    style FUTURE fill:#ffffff,stroke:#b7791f,stroke-width:1.5px,color:#111111&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="mKZ5JzS8KgBF5nCEPrLf-281">
